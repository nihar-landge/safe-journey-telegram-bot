# --- Required ---
BOT_TOKEN=your_telegram_bot_token_here
GROUP_CHAT_ID=your_private_group_chat_id_here

# --- Plate Recognizer Cloud API (Optional) ---
PLATE_REC_TOKEN=your_plate_recognizer_api_token_here

# --- Timezone Settings ---
TIMEZONE=Asia/Kolkata

# --- Optional System Defaults ---
EMERGENCY_CONTACT_ID=optional_fallback_telegram_user_id
OVERDUE_BUFFER_MINUTES=10
SAFE_EXTENSION_MINUTES=15
ESCALATION_AFTER_ALERTS=2
CHECK_INTERVAL_SECONDS=60
DB_PATH=trips.db
LOG_LEVEL=INFO
